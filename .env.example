# Environment Mode & Port
NODE_ENV=production
PORT=8000

# Server Public Base URL
BACKEND_URL=https://cdn.yourdomain.com

# Allowed CORS Origins (comma-separated for multiple domains)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://rajseba.in,https://household-services-frontend-lc2h.vercel.app,https://ai-power-admin-console.vercel.app

# Cloudflare R2 / S3 Object Storage Configuration (Optional - falls back to local uploads if unconfigured)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_DOMAIN=https://cdn-assets.yourdomain.com